# Codemagic / APK export configuration
# Copy this into a real .env file if needed for local development and CI.
# Do not commit real secrets.

# Required for Gemini API calls when used by the app:
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional Android signing variables for Codemagic:
# KEYSTORE_PATH=/path/to/keystore.jks
# STORE_PASSWORD=your_store_password
# KEY_PASSWORD=your_key_password
